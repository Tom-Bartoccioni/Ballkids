# Base de données SQLite. Chemin relatif au dossier backend/prisma/ (comme pour le
# CLI Prisma) : le fichier sera backend/prisma/dev.db. Voir docker-compose pour la prod.
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Serveur
PORT=3001
NODE_ENV=development

# URL du frontend (pour CORS)
FRONTEND_URL="http://localhost:5173"

# ── Mode démonstration (instance publique avec données fictives) ──
# Active les garde-fous (blocage changement de mot de passe, limites d'upload
# durcies) et la réinitialisation automatique de la base.
# DEMO_MODE="true"
# Fréquence de réinitialisation de la base de démo, en heures (défaut: 24)
# DEMO_RESET_INTERVAL_HOURS="24"
